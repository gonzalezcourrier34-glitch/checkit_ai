# Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=checkit-airflow:3.3.0
AIRFLOW_PROJ_DIR=.

# Compte local de démonstration
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Paramètres applicatifs non sensibles
USER_AGENT=CheckItAI/1.0

# PostgreSQL du dashboard lancé depuis Windows
CHECKIT_POSTGRES_HOST=localhost
CHECKIT_POSTGRES_PORT=5432
CHECKIT_POSTGRES_DATABASE=checkit
CHECKIT_POSTGRES_USER=checkit_et1
CHECKIT_POSTGRES_PASSWORD=xxxxxxxx
CHECKIT_DATABASE_SCHEMA=checkit